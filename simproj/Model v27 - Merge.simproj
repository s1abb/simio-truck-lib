  <CommonItems>
    <Definitions>
      <EntityDefinition Name="obj_Battery" Id="b6402956-190d-4781-95f3-5214dd2f188b" Revision="28" FileVersion="256" Author="GHD" Description="Battery entity with state tracking for SOC, health, and degradation. This object represents an individual battery pack that can be swapped between trucks and charged at swap stations. It tracks state of charge (SOC), cumulative energy throughput, and battery health degradation based on total energy cycled. Battery health degrades linearly from 100% to the end-of-life threshold (typically 80%) over the rated lifetime throughput.&#xD;&#xA;&#xD;&#xA;**Key Characteristics:**&#xD;&#xA;- **Swappable**: Moves between truck `BatteryStation` and swap station `BatteryStation`&#xD;&#xA;- **State tracking**: SOC decreases during discharge, increases during charging&#xD;&#xA;- **Degradation model**: Linear health decline based on cumulative throughput (both charging and discharging)&#xD;&#xA;- **Resource states**: ReadyToDeploy, Deployed, ReadyToCharge, Charging, OutOfService&#xD;&#xA;- **Lifecycle tracking**: Charging cycles, time in states, throughput history&#xD;&#xA;- **Visual indicator**: Symbol index updates based on SOC levels (green→yellow→orange→red)" ResourceLogic="True" CreationDateTime="2025-10-29T07:04:50.6644612Z">
        <FileRef Name="Models\obj_Battery\b6402956-190d-4781-95f3-5214dd2f188b.xml" />
      </EntityDefinition>
      <TransporterDefinition Name="obj_BatteryElectricTruck" Id="940d3336-b0a9-4c5a-ac1b-6ea85fad832a" Revision="30" FileVersion="256" BaseClass="obj_Truck" Author="AECOM ITAM" CreationDateTime="2025-12-03T06:48:28.6417021Z">
        <FileRef Name="Models\obj_BatteryElectricTruck\940d3336-b0a9-4c5a-ac1b-6ea85fad832a.xml" />
      </TransporterDefinition>
      <TransporterDefinition Name="obj_BatterySwapChargeStation" Id="581c00ec-310a-48a3-a5c8-55fa7d2a0c20" Revision="138" FileVersion="256" BaseClass="Vehicle" Author="GHD" Description="This object manages battery swapping operations and charging infrastructure for battery-electric trucks:&#xD;&#xA;&#xD;&#xA;**Core Functions:**&#xD;&#xA;- **Battery inventory** - Maintains pools of batteries in different states (ready to deploy, charging, ready to charge)&#xD;&#xA;- **Concurrent charging** - Supports multiple charging ports (1-8 configurable) with individual power limits&#xD;&#xA;- **Charging simulation** - Updates battery SOC and degradation during charging with configurable efficiency losses&#xD;&#xA;- **Automated swap sequence** - Coordinates 10-step battery exchange operation between trucks and inventory&#xD;&#xA;- **Out-of-service tracking** - Logs batteries that reach end-of-life or fail to output table" CreationDateTime="2025-11-05T12:42:02.2994499Z">
        <FileRef Name="Models\obj_BatterySwapChargeStation\581c00ec-310a-48a3-a5c8-55fa7d2a0c20.xml" />
      </TransporterDefinition>
      <TransporterDefinition Name="obj_Digger" Id="f8d70a86-7d7b-4d42-9f41-28b85861959b" Revision="19" FileVersion="256" BaseClass="Vehicle" Author="AECOM ITAM" CreationDateTime="2026-01-27T04:00:11.8755528Z">
        <FileRef Name="Models\obj_Digger\f8d70a86-7d7b-4d42-9f41-28b85861959b.xml" />
      </TransporterDefinition>
      <LinkDefinition Name="obj_ElectricPath" Id="eab198c9-9c19-494e-86f3-8e26a92ea5fa" Revision="106" FileVersion="256" BaseClass="Path" Author="GHD" Description="Path object that supports Simio default path functionality as well as Battery Electric Truck and Trolley Assist Truck operations." CreationDateTime="2025-10-24T00:35:01.0349241Z" FlowConstraintMode="Default" Color="9acd32">
        <FileRef Name="Models\obj_ElectricPath\eab198c9-9c19-494e-86f3-8e26a92ea5fa.xml" />
      </LinkDefinition>
      <EntityDefinition Name="obj_Load" Id="77f5087d-97f7-4bcc-9057-e881090cac73" Revision="11" FileVersion="256" Author="GHD" Description="Load entity." CreationDateTime="2025-11-21T07:23:53.4536319Z">
        <FileRef Name="Models\obj_Load\77f5087d-97f7-4bcc-9057-e881090cac73.xml" />
      </EntityDefinition>
      <TransporterDefinition Name="obj_Truck" Id="d4fd2d94-9ab2-4136-82fe-82e839132775" Revision="170" FileVersion="256" BaseClass="Vehicle" Author="GHD" Description="This object implements a battery-electric mining truck with discrete-event simulation and continuous physics updates:&#xD;&#xA;&#xD;&#xA;**Core Simulation Features:**&#xD;&#xA;- **Target speed control** - Accelerates (consumes power) when below target, retards (regenerates) when above&#xD;&#xA;- **Physics calculations** - Force-based acceleration using rimpull, grade resistance, and rolling resistance (F=ma)&#xD;&#xA;- **Battery power modeling** - Motoring and regenerative braking with efficiency losses (92% motor, 75% regen)&#xD;&#xA;- **Performance degradation** - Reduced tractive force as battery health declines (optional toggle)&#xD;&#xA;- **Battery swapping** - Automatic swap triggered when SOC falls below threshold&#xD;&#xA;&#xD;&#xA;**Implementation Details:**&#xD;&#xA;- **Update frequency**: 1-second timestep via `tmr_TimeStep` timer&#xD;&#xA;- **Process**: `proc_SpeedBatteryUpdates` executes 7 calculation sections per timestep&#xD;&#xA;- **Battery integration**: Single battery entity held in `BatteryStation`&#xD;&#xA;- **Speed display**: Dynamic label shows current speed in km/h&#xD;&#xA;- **Symbol states**: Index 0 (tray down) and Index 1 (tray raised during loading/swapping)&#xD;&#xA;&#xD;&#xA;**Data-Driven Configuration:**&#xD;&#xA;- **Truck types table** (`tbl_TruckTypes`): Vehicle specifications (weights, forces, efficiencies)&#xD;&#xA;- **Battery types table** (`tbl_BatteryTypes`): Battery specifications (capacity, cycles, health thresholds)&#xD;&#xA;- **Lookup functions**: Grade-dependent max speeds, speed-dependent rimpull/retard forces (CAT_794AC)" CreationDateTime="2025-10-24T00:01:48.6442287Z">
        <FileRef Name="Models\obj_Truck\d4fd2d94-9ab2-4136-82fe-82e839132775.xml" />
      </TransporterDefinition>
      <FixedDefinition Name="Model" Id="62e7fb84-6e6a-4449-a112-6ea828d36945" Revision="328" FileVersion="256" Author="GHD" CreationDateTime="2025-10-23T23:56:47.2905033Z">
        <FileRef Name="Models\Model\62e7fb84-6e6a-4449-a112-6ea828d36945.xml" />
      </FixedDefinition>
