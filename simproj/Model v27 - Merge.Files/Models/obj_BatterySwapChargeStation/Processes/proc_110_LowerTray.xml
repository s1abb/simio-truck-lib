      <Step Type="Resume" Name="Movement" Description="Resume movement of truck object" ID="5">
        <Properties>
          <Property Name="ResumeType">ObjectMovement</Property>
          <Property Name="ObjectType">SpecificObject</Property>
          <Property Name="Object">
            <Value>var_BatteryElectricTruckObjectReference</Value>
          </Property>
        </Properties>
      </Step>
      <Step Type="Delay" Name="TaskDuration" Description="Delay for `tbl_Tasks.TaskDuration`" ID="6">
