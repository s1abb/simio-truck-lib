<Fragment>
  <Process Name="proc_Loaded_False" BeginStepID="2" Category="20 Interface" Description="Clears the truck's loaded state, causing physics calculations to use the empty operating weight instead of loaded weight.">
    <Properties>
      <Property Name="TriggeringEventName">event_Loaded_False</Property>
    </Properties>
    <Steps>
      <Step Type="Assign" Name="LoadedFalse" Description="Set `var_Loaded = False`" ID="2">
        <Properties>
          <Property Name="StateVariableName">
            <Value>var_Loaded</Value>
          </Property>
          <Property Name="NewValue">False</Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="3" />
      </Step>
      <Step Type="Assign" Name="Payload" Description="Assign `var_Payload = prop_AveragePayload × prop_PayloadDistribution`" ID="3">
        <Properties>
          <Property Name="StateVariableName">
            <Value>var_Payload</Value>
          </Property>
          <Property Name="NewValue" Units="Metric Tons">0</Property>
        </Properties>
      </Step>
    </Steps>
  </Process>
</Fragment>
