<Fragment>
  <Process Name="proc_AllocateDigger" BeginStepID="3" Category="80 Loop Processes">
    <Properties />
    <Steps>
      <Step Type="Decide" Name="ReadyToAllocate" ID="2">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">obj_Digger.var_DiggerResourceState == obj_Digger.List.list_DiggerResourceStates.ReadyToAllocate</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="9" />
      </Step>
      <Step Type="Search" Name="list_Diggers" ID="3">
        <Properties>
          <Property Name="CollectionType">ObjectList</Property>
          <Property Name="ObjectListName">list_Diggers</Property>
          <Property Name="Limit">Infinity</Property>
        </Properties>
        <Exit Name="Found" Type="Alternate" NextID="2" />
      </Step>
      <Step Type="Assign" Name="var_Debug" Description="Toggle debug flag" Color="ffffff" ID="4">
        <Properties>
          <Property Name="StateVariableName">
            <Value>var_Debug</Value>
          </Property>
          <Property Name="NewValue">Math.If(var_Debug,False,True)</Property>
        </Properties>
      </Step>
      <Step Type="SetNode" Name="DestinationNode" ID="5">
        <Properties>
          <Property Name="NodeName">obj_Digger.var_ManualControlDestinationNode</Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="11" />
      </Step>
      <Step Type="Seize" Name="obj_Digger" ID="6">
        <Properties>
          <Property Name="ResourceSeizes">
            <Rows>
              <Properties>
                <Property Name="ResourceName">obj_Digger</Property>
              </Properties>
            </Rows>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="5" />
      </Step>
      <Step Type="Assign" Name="Variables" Color="d7e3bc" ID="7">
        <Properties>
          <Property Name="Assignments">
            <Rows>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>obj_Digger.var_MineBlockNodeReference_Previous</Value>
                </Property>
                <Property Name="AssignmentsNewValue">obj_Digger.var_MineBlockNodeReference_Current</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>obj_Digger.var_MineBlockNodeReference_Current</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_MineBlocks.Name</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tbl_MineBlocks.DiggerReference</Value>
                </Property>
                <Property Name="AssignmentsNewValue">obj_Digger</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tbl_MineBlocks.DiggerAllocated</Value>
                </Property>
                <Property Name="AssignmentsNewValue">True</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tbl_MineSequence.DiggerCurrentlyAllocated</Value>
                </Property>
                <Property Name="AssignmentsNewValue">True</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>obj_Digger.var_ManualControlDestinationNode</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_MineSequence.MineBlockNode</Property>
              </Properties>
            </Rows>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="6" />
      </Step>
      <Step Type="Assign" Name="ResourceState" Color="c6d9f0" ID="8">
        <Properties>
          <Property Name="StateVariableName">
            <Value>obj_Digger.var_DiggerResourceState</Value>
          </Property>
          <Property Name="NewValue">obj_Digger.List.list_DiggerResourceStates.TravellingToMineBlock</Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="7" />
      </Step>
      <Step Type="Search" Name="tbl_MineSequence" ID="9">
        <Properties>
          <Property Name="CollectionType">TableRows</Property>
          <Property Name="TableName">tbl_MineSequence</Property>
          <Property Name="MatchCondition">!tbl_MineSequence.TonnesDepleted</Property>
        </Properties>
        <Exit Name="Original" Type="Primary" NextID="10" />
        <Exit Name="Found" Type="Alternate" NextID="8" />
      </Step>
      <Step Type="Assign" Name="var_Debug" Description="Toggle debug flag" Color="ffffff" ID="10">
        <Properties>
          <Property Name="StateVariableName">
            <Value>var_Debug</Value>
          </Property>
          <Property Name="NewValue">Math.If(var_Debug,False,True)</Property>
        </Properties>
      </Step>
      <Step Type="Decide" Name="IsParked" ID="11">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">obj_Digger.IsParked</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="12" />
      </Step>
      <Step Type="UnPark" Name="obj_Digger" ID="12">
        <Properties>
          <Property Name="EntityType">SpecificObject</Property>
          <Property Name="EntityObject">
            <Value>obj_Digger</Value>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="4" />
      </Step>
    </Steps>
  </Process>
</Fragment>
