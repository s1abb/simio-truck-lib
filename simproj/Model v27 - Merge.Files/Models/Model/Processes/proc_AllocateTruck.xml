<Fragment>
  <Process Name="proc_AllocateTruck" BeginStepID="9" Category="80 Loop Processes">
    <Properties />
    <Steps>
      <Step Type="Search" Name="tbl_MineBlocks" ID="2">
        <Properties>
          <Property Name="CollectionType">TableRows</Property>
          <Property Name="TableName">tbl_MineBlocks</Property>
          <Property Name="SearchType">MinimizeExpression</Property>
          <Property Name="MatchCondition">tbl_MineBlocks.DiggerAllocated &amp;&amp; tbl_MineBlocks.DiggerOnLocation &amp;&amp; !tbl_MineBlocks.MineBlockDepleted</Property>
          <Property Name="SearchExpression">tbl_MineBlocks.TrucksAssigned</Property>
        </Properties>
        <Exit Name="Original" Type="Primary" NextID="7" />
        <Exit Name="Found" Type="Alternate" NextID="11" />
      </Step>
      <Step Type="Assign" Name="Variables" Color="d7e3bc" ID="3">
        <Properties>
          <Property Name="Assignments">
            <Rows>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tbl_MineBlocks.TrucksAssigned</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_MineBlocks.TrucksAssigned+1</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>obj_Truck.var_MineBlockNodeReference</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_MineBlocks.Name</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>obj_Truck.var_DiggerReference</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_MineBlocks.DiggerReference</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>obj_Truck.var_ManualControlDestinationNode</Value>
                </Property>
                <Property Name="AssignmentsNewValue">obj_Truck.var_MineBlockNodeReference</Property>
              </Properties>
            </Rows>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="4" />
      </Step>
      <Step Type="Seize" Name="obj_Truck" ID="4">
        <Properties>
          <Property Name="ResourceSeizes">
            <Rows>
              <Properties>
                <Property Name="ResourceName">obj_Truck</Property>
              </Properties>
            </Rows>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="5" />
      </Step>
      <Step Type="SetNode" Name="ManualControlDestinationNode" ID="5">
        <Properties>
          <Property Name="NodeName">obj_Truck.var_ManualControlDestinationNode</Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="8" />
      </Step>
      <Step Type="UnPark" Name="obj_Truck" ID="6">
        <Properties>
          <Property Name="EntityType">SpecificObject</Property>
          <Property Name="EntityObject">
            <Value>obj_Truck</Value>
          </Property>
        </Properties>
      </Step>
      <Step Type="Assign" Name="var_Debug" Description="Toggle debug flag" Color="ffffff" ID="7">
        <Properties>
          <Property Name="StateVariableName">
            <Value>var_Debug</Value>
          </Property>
          <Property Name="NewValue">Math.If(var_Debug,False,True)</Property>
        </Properties>
      </Step>
      <Step Type="Decide" Name="IsParked" ID="8">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">obj_Truck.IsParked</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="6" />
      </Step>
      <Step Type="Search" Name="list_Trucks" ID="9">
        <Properties>
          <Property Name="CollectionType">ObjectList</Property>
          <Property Name="ObjectListName">list_Trucks</Property>
          <Property Name="Limit">Infinity</Property>
        </Properties>
        <Exit Name="Found" Type="Alternate" NextID="10" />
      </Step>
      <Step Type="Decide" Name="ReadyToAllocate" ID="10">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">obj_Truck.var_TruckResourceState == obj_Truck.List.list_TruckResourceStates.ReadyToAllocate</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="12" />
      </Step>
      <Step Type="Assign" Name="ResourceState" Color="c6d9f0" ID="11">
        <Properties>
          <Property Name="StateVariableName">
            <Value>obj_Truck.var_TruckResourceState</Value>
          </Property>
          <Property Name="NewValue">obj_Truck.List.list_TruckResourceStates.TravellingToMineBlock</Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="3" />
      </Step>
      <Step Type="Decide" Name="var_OnShift" ID="12">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">var_OnShift</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="2" />
      </Step>
    </Steps>
  </Process>
</Fragment>
