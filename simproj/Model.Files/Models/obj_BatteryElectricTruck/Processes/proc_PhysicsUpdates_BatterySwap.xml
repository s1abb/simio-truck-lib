<Fragment>
  <Process Name="proc_PhysicsUpdates_BatterySwap" BeginStepID="3" Category="31 Time Step Processes  (BatterySwapTruck)">
    <Properties>
      <Property Name="TokenClassName">tkn_Physics</Property>
    </Properties>
    <Steps>
      <Step Type="Assign" Name="SpeedUpdates" Color="c3d69b" ID="2">
        <Properties>
          <Property Name="Assignments">
            <Rows>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.CurrentGrade</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Movement.Pitch</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.CurrentSpeedKmh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Movement.Rate</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.RowIndex</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes.TruckType.RowForKey(String.FromList(list_TruckTypes, prop_TruckType))</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.EmptyWeightKg</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].EmptyOperatingWeightKg</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.CurrentWeightKg</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(var_Loaded, var_Payload, tkn_Physics.EmptyWeightKg)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.BaseRimpullForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].RimpullForceN</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.BaseRetardForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].RetardForceN</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.MaxSpeedKmh_Loaded</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].MaxSpeedKmh_Loaded</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.MaxSpeedKmh_Empty</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].MaxSpeedKmh_Empty</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.RollingResistance</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].RollingResistance</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.MotorEfficiencyPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].MotorEfficiencyPct</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.RegenEfficiencyPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].RegenEfficiencyPct</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.AuxiliaryPowerDemandKw</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].AuxiliaryPowerDemandKw</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.SwapBatterySOCPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,0,tbl_TruckTypes[tkn_Physics.RowIndex].SwapBatterySOCPct)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.BatteryHealthPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,100,BatteryStation.Contents.FirstItem.obj_Battery.var_BatteryHealthPct)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.RatedBatteryStorageEnergyKwh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,0,BatteryStation.Contents.FirstItem.obj_Battery.var_RatedStorageEnergyKwh)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.EndOfLifeBatteryHealthPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,0,BatteryStation.Contents.FirstItem.obj_Battery.var_EndOfLifeBatteryHealthPct)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.CurrentBatterySOCPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,100,BatteryStation.Contents.FirstItem.obj_Battery.var_BatterySOCPct)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.MaxSpeedKmh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(var_Loaded, tkn_Physics.MaxSpeedKmh_Loaded, tkn_Physics.MaxSpeedKmh_Empty)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.PathSpeedLimitKmh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(
	Location.Parent.Is.obj_ElectricPath,
	Location.Parent.obj_ElectricPath.SpeedLimit,
	DesiredSpeed
)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.TargetSpeedKmh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.Min(tkn_Physics.PathSpeedLimitKmh, tkn_Physics.MaxSpeedKmh)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.PowerDegradationFactor</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(
	prop_PowerDegradationActive,
	Math.Max(
		tkn_Physics.BatteryHealthPct / 100,
		tkn_Physics.EndOfLifeBatteryHealthPct / 100
	),
	1.0
)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.GradeResistanceForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.CurrentWeightKg * 9.81 * Math.Sin(Math.Atan(tkn_Physics.CurrentGrade / 100))</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.RollingResistanceForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.CurrentWeightKg * 9.81 * tkn_Physics.RollingResistance</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.TotalResistanceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.GradeResistanceForceN + tkn_Physics.RollingResistanceForceN</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.TractiveForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(
	tkn_Physics.CurrentSpeedKmh &lt; tkn_Physics.TargetSpeedKmh - 3000,
	tkn_Physics.BaseRimpullForceN * tkn_Physics.PowerDegradationFactor,
		Math.If(
			tkn_Physics.CurrentSpeedKmh &gt; tkn_Physics.TargetSpeedKmh + 3000,
			-tkn_Physics.BaseRetardForceN * tkn_Physics.PowerDegradationFactor,
			0
	)
)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.NetTractiveForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.TractiveForceN - tkn_Physics.TotalResistanceN</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.AccelerationMs2</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.NetTractiveForceN / tkn_Physics.CurrentWeightKg</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.NewSpeedKmh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.Max(
	0,
	Math.Min(
		tkn_Physics.TargetSpeedKmh,
		tkn_Physics.CurrentSpeedKmh + tkn_Physics.AccelerationMs2* 3600 * prop_TimeStepSeconds * 3600
	)
)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>Movement.Rate</Value>
                </Property>
                <Property Name="AssignmentsNewValue" Units="Kilometers per Hour">tkn_Physics.NewSpeedKmh</Property>
              </Properties>
            </Rows>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="4" />
      </Step>
      <Step Type="Decide" Name="SpeedUpdates" ID="3">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">var_SpeedUpdates</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="2" />
        <Exit Name="False" Type="Alternate" NextID="4" />
      </Step>
      <Step Type="Decide" Name="BatteryUpdates" ID="4">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">var_BatteryUpdates</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="5" />
      </Step>
      <Step Type="Assign" Name="BatteryUpdates" Color="b2a2c7" ID="5">
        <Properties>
          <Property Name="Assignments">
            <Rows>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.RowIndex</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes.TruckType.RowForKey(String.FromList(list_TruckTypes, prop_TruckType))</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.AuxiliaryPowerDemandKw</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].AuxiliaryPowerDemandKw</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.SwapBatterySOCPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,0,tbl_TruckTypes[tkn_Physics.RowIndex].SwapBatterySOCPct)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.CurrentBatterySOCPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,100,BatteryStation.Contents.FirstItem.obj_Battery.var_BatterySOCPct)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.BatteryHealthPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,100,BatteryStation.Contents.FirstItem.obj_Battery.var_BatteryHealthPct)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.RatedBatteryStorageEnergyKwh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,0,BatteryStation.Contents.FirstItem.obj_Battery.var_RatedStorageEnergyKwh)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.RatedLifetimeThroughputKwh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,0,BatteryStation.Contents.FirstItem.obj_Battery.var_RatedLifetimeThroughputKwh)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.EndOfLifeBatteryHealthPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,0,BatteryStation.Contents.FirstItem.obj_Battery.var_EndOfLifeBatteryHealthPct)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.CurrentCumulativeThroughputKwh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_TruckTypes[tkn_Physics.RowIndex].TruckMode==List.list_TruckMode.DieselElectric,0,BatteryStation.Contents.FirstItem.obj_Battery.var_BatteryCumulativeThroughputKwh)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.PowerDegradationFactor</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(
	prop_PowerDegradationActive,
	Math.Max(
		tkn_Physics.BatteryHealthPct / 100,
		tkn_Physics.EndOfLifeBatteryHealthPct / 100
	),
	1.0
)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.MotorMechanicalPowerKw</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(var_SpeedUpdates, (tkn_Physics.TractiveForceN / 1000) * (tkn_Physics.CurrentSpeedKmh / 3600), 0)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.BatteryPowerKw</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(
	tkn_Physics.MotorMechanicalPowerKw &gt; 0,
	tkn_Physics.MotorMechanicalPowerKw / (tkn_Physics.MotorEfficiencyPct / 100),
	Math.If(
		tkn_Physics.MotorMechanicalPowerKw &lt; 0,
		tkn_Physics.MotorMechanicalPowerKw * (tkn_Physics.RegenEfficiencyPct / 100),
		tkn_Physics.AuxiliaryPowerDemandKw
	)
)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.EnergyDeltaKwh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.BatteryPowerKw * prop_TimeStepSeconds</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.EffectiveBatteryCapacityKwh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.RatedBatteryStorageEnergyKwh * tkn_Physics.PowerDegradationFactor</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.NewBatterySOCPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.Max(
	0,
	Math.Min(
		100,
		tkn_Physics.CurrentBatterySOCPct - 100 * tkn_Physics.EnergyDeltaKwh / tkn_Physics.EffectiveBatteryCapacityKwh
	)
)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.AbsoluteEnergyThroughputKwh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.Abs(tkn_Physics.EnergyDeltaKwh)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.NewCumulativeThroughputKwh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.CurrentCumulativeThroughputKwh + tkn_Physics.AbsoluteEnergyThroughputKwh</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.NewBatteryHealthPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.Max(
	tkn_Physics.EndOfLifeBatteryHealthPct,
	100 - (tkn_Physics.NewCumulativeThroughputKwh / (tkn_Physics.RatedLifetimeThroughputKwh * (100 - tkn_Physics.EndOfLifeBatteryHealthPct)))
)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>var_SwapRefuelChargeFlag</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tkn_Physics.NewBatterySOCPct &lt; tkn_Physics.SwapBatterySOCPct, True, False)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>BatteryStation.Contents.FirstItem.obj_Battery.var_BatterySOCPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.NewBatterySOCPct</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>BatteryStation.Contents.FirstItem.obj_Battery.var_BatteryCumulativeThroughputKwh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.NewCumulativeThroughputKwh</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>BatteryStation.Contents.FirstItem.obj_Battery.var_BatteryHealthPct</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.NewBatteryHealthPct</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>BatteryStation.Contents.FirstItem.obj_Battery.var_CurrentSymbolIndex</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(
	tkn_Physics.NewBatterySOCPct &gt;= 80, obj_Battery.List.list_CurrentSymbolIndex.Green,
	Math.If(
		tkn_Physics.NewBatterySOCPct &gt;= 60, obj_Battery.List.list_CurrentSymbolIndex.Yellow,
		Math.If(
			tkn_Physics.NewBatterySOCPct &gt;= 40, obj_Battery.List.list_CurrentSymbolIndex.Orange,
			Math.If(
				tkn_Physics.NewBatterySOCPct &gt;= 20, obj_Battery.List.list_CurrentSymbolIndex.DarkOrange,
				obj_Battery.List.list_CurrentSymbolIndex.Red
			)
		)
	)
)</Property>
              </Properties>
            </Rows>
          </Property>
        </Properties>
      </Step>
    </Steps>
  </Process>
</Fragment>
