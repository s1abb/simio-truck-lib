<Fragment>
  <Process Name="proc_MineBlock_OnEntered" BeginStepID="2" Category="70 Mine Block Processes">
    <Properties />
    <Steps>
      <Step Type="Decide" Name="obj_Digger" ID="2">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">Object.Is.obj_Digger &amp;&amp; obj_Digger.CurrentNode == obj_Digger.DestinationNode</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="12" />
        <Exit Name="False" Type="Alternate" NextID="5" />
      </Step>
      <Step Type="Park" Name="obj_TransferNode" ID="3">
        <Properties>
          <Property Name="NodeName">obj_Digger.var_MineBlockNodeReference_Current</Property>
        </Properties>
        <Exit Name="OK" Type="Primary" NextID="14" />
      </Step>
      <Step Type="Assign" Name="var_Debug" Description="Toggle debug flag" Color="ffffff" ID="4">
        <Properties>
          <Property Name="StateVariableName">
            <Value>var_Debug</Value>
          </Property>
          <Property Name="NewValue">Math.If(var_Debug,False,True)</Property>
        </Properties>
      </Step>
      <Step Type="Decide" Name="obj_Truck" ID="5">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">Object.Is.obj_Truck</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="18" />
      </Step>
      <Step Type="Execute" Name="proc_CreateLoad" ID="6">
        <Properties>
          <Property Name="ProcessName">
            <Value>obj_MineBlock.proc_CreateLoad</Value>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="9" />
      </Step>
      <Step Type="Assign" Name="Variables" Color="d7e3bc" ID="7">
        <Properties>
          <Property Name="Assignments">
            <Rows>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tbl_MineSequence.TonnesLoaded</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_MineSequence.TonnesLoaded+obj_MineBlock.RidePickupQueue.FirstItem.obj_Load.var_PayLoad</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tbl_MineSequence.TonnesRemaining</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_MineSequence.TonnesAvailable-tbl_MineSequence.TonnesLoaded</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tbl_MineSequence.TonnesDepleted</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tbl_MineSequence.TonnesLoaded&gt;tbl_MineSequence.TonnesAvailable,True,False)</Property>
              </Properties>
            </Rows>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="15" />
      </Step>
      <Step Type="Search" Name="tbl_MineSequence" ID="8">
        <Properties>
          <Property Name="CollectionType">TableRows</Property>
          <Property Name="TableName">tbl_MineSequence</Property>
          <Property Name="SearchRelatedRowsOnly">False</Property>
          <Property Name="MatchCondition">tbl_MineSequence.MineBlockNode==obj_MineBlock &amp;&amp; tbl_MineSequence.DiggerCurrentlyAllocated</Property>
        </Properties>
        <Exit Name="Original" Type="Primary" NextID="16" />
        <Exit Name="Found" Type="Alternate" NextID="7" />
      </Step>
      <Step Type="Assign" Name="PayLoad" ID="9">
        <Properties>
          <Property Name="StateVariableName">
            <Value>obj_MineBlock.RidePickupQueue.FirstItem.obj_Load.var_PayLoad</Value>
          </Property>
          <Property Name="NewValue">Math.If(obj_Truck.Is.obj_BatteryElectricTruck,fx_obj_BatteryElectricTruck_AvgPayLoad,fx_obj_Truck_AvgPayLoad)</Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="8" />
      </Step>
      <Step Type="Decide" Name="Ridestation.Contents=0" ID="10">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">obj_Truck.RideStation.Contents.NumberWaiting==0</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="6" />
      </Step>
      <Step Type="Assign" Name="DiggerOnLocation" ID="11">
        <Properties>
          <Property Name="StateVariableName">
            <Value>tbl_MineBlocks[tbl_MineBlocks.Name.RowForKey(obj_Digger.var_MineBlockNodeReference_Current)].DiggerOnLocation</Value>
          </Property>
          <Property Name="NewValue">True</Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="3" />
      </Step>
      <Step Type="Assign" Name="ResourceState" Color="c6d9f0" ID="12">
        <Properties>
          <Property Name="StateVariableName">
            <Value>obj_Digger.var_DiggerResourceState</Value>
          </Property>
          <Property Name="NewValue">obj_Digger.List.list_DiggerResourceStates.LoadingAtMineBlock</Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="11" />
      </Step>
      <Step Type="Assign" Name="ResourceState" Color="c6d9f0" ID="13">
        <Properties>
          <Property Name="StateVariableName">
            <Value>obj_Truck.var_TruckResourceState</Value>
          </Property>
          <Property Name="NewValue">obj_Truck.List.list_TruckResourceStates.LoadingAtMineBlock</Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="10" />
      </Step>
      <Step Type="Release" Name="obj_Digger" ID="14">
        <Properties>
          <Property Name="ResourceReleases">
            <Rows>
              <Properties>
                <Property Name="ResourceName">obj_Digger</Property>
              </Properties>
            </Rows>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="17" />
      </Step>
      <Step Type="Assign" Name="DumpPoint" ID="15">
        <Properties>
          <Property Name="StateVariableName">
            <Value>obj_Truck.var_ManualControlDestinationNode</Value>
          </Property>
          <Property Name="NewValue">tbl_MineSequence.DumpPoint</Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="4" />
      </Step>
      <Step Type="SetNode" Name="DumpPoint" ID="16">
        <Properties>
          <Property Name="EntityType">SpecificObject</Property>
          <Property Name="EntityObject">
            <Value>obj_MineBlock.RidePickupQueue.FirstItem.obj_Load</Value>
          </Property>
          <Property Name="NodeName">obj_Truck.var_ManualControlDestinationNode</Property>
        </Properties>
      </Step>
      <Step Type="Assign" Name="var_Debug" Description="Toggle debug flag" Color="ffffff" ID="17">
        <Properties>
          <Property Name="StateVariableName">
            <Value>var_Debug</Value>
          </Property>
          <Property Name="NewValue">Math.If(var_Debug,False,True)</Property>
        </Properties>
      </Step>
      <Step Type="Decide" Name="ParkingStation&gt;0" ID="18">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">obj_MineBlock.ParkingStation.Contents.NumberWaiting != 0</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="13" />
      </Step>
    </Steps>
  </Process>
</Fragment>
