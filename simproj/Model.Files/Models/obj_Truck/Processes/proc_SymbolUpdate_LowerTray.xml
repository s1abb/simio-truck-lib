<Fragment>
  <Process Name="proc_SymbolUpdate_LowerTray" BeginStepID="2" Category="20 Interface" Description="Updates the truck's visual symbol to show the tray in lowered position, indicating normal operational state.">
    <Properties>
      <Property Name="TriggeringEventName">event_SymbolUpdate_LowerTray</Property>
    </Properties>
    <Steps>
      <Step Type="Assign" Name="CurrentSymbolIndex" Description="Set `var_CurrentSymbolIndex = 0` (tray down symbol)" ID="2">
        <Properties>
          <Property Name="StateVariableName">
            <Value>var_CurrentSymbolIndex_Truck</Value>
          </Property>
          <Property Name="NewValue">List.list_CurrentSymbolIndex_Truck.DieselElectricTrayDown</Property>
        </Properties>
      </Step>
    </Steps>
  </Process>
</Fragment>
