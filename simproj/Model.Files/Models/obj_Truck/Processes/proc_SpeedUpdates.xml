<Fragment>
  <Process Name="proc_SpeedUpdates" BeginStepID="3" Category="30 Time Step Processes">
    <Properties>
      <Property Name="TokenClassName">tkn_Physics</Property>
    </Properties>
    <Steps>
      <Step Type="Assign" Name="TargetSpeed" Color="c3d69b" ID="2">
        <Properties>
          <Property Name="Assignments">
            <Rows>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.CurrentGrade</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Movement.Pitch</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.CurrentSpeedKmh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Movement.Rate</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.RowIndex</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes.TruckType.RowForKey(String.FromList(list_TruckTypes, prop_TruckType))</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.EmptyWeightKg</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].EmptyOperatingWeightKg</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.CurrentWeightKg</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(var_Loaded, var_Payload, tkn_Physics.EmptyWeightKg)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.BaseRimpullForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].RimpullForceN</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.BaseRetardForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].RetardForceN</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.MaxSpeedKmh_Loaded</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].MaxSpeedKmh_Loaded</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.MaxSpeedKmh_Empty</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].MaxSpeedKmh_Empty</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.RollingResistance</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tbl_TruckTypes[tkn_Physics.RowIndex].RollingResistance</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.MaxSpeedKmh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(var_Loaded, tkn_Physics.MaxSpeedKmh_Loaded, tkn_Physics.MaxSpeedKmh_Empty)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.PathSpeedLimitKmh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(
	Location.Parent.Is.obj_ElectricPath,
	Location.Parent.obj_ElectricPath.SpeedLimit,
	DesiredSpeed
)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.TargetSpeedKmh</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.Min(tkn_Physics.PathSpeedLimitKmh, tkn_Physics.MaxSpeedKmh)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.GradeResistanceForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.CurrentWeightKg * 9.81 * Math.Sin(Math.Atan(tkn_Physics.CurrentGrade / 100))</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.RollingResistanceForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.CurrentWeightKg * 9.81 * tkn_Physics.RollingResistance</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.TotalResistanceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.GradeResistanceForceN + tkn_Physics.RollingResistanceForceN</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.TrueAccelerate_FalseDecelerate</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.TargetSpeedKmh &gt; tkn_Physics.CurrentSpeedKmh</Property>
              </Properties>
            </Rows>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="5" />
      </Step>
      <Step Type="Decide" Name="SpeedUpdates" ID="3">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">var_SpeedUpdates</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="2" />
      </Step>
      <Step Type="Assign" Name="SpeedUpdates" Color="c3d69b" ID="4">
        <Properties>
          <Property Name="Assignments">
            <Rows>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.TractiveForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">Math.If(tkn_Physics.TrueAccelerate_FalseDecelerate,tkn_Physics.BaseRimpullForceN,-tkn_Physics.BaseRetardForceN)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.NetTractiveForceN</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.TractiveForceN - tkn_Physics.TotalResistanceN</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.AccelerationMs2</Value>
                </Property>
                <Property Name="AssignmentsNewValue">tkn_Physics.NetTractiveForceN / tkn_Physics.CurrentWeightKg</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.PhysicsDelaySeconds</Value>
                </Property>
                <Property Name="AssignmentsNewValue" Units="Seconds">Math.Max(0,1/(3.6*tkn_Physics.AccelerationMs2))</Property>
              </Properties>
            </Rows>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="5" />
      </Step>
      <Step Type="Delay" Name="PhysicsDelay" ID="5">
        <Properties>
          <Property Name="DelayTime" Units="Seconds">tkn_Physics.PhysicsDelaySeconds</Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="6" />
      </Step>
      <Step Type="Assign" Name="Speed+1/-1" Color="c3d69b" ID="6">
        <Properties>
          <Property Name="Assignments">
            <Rows>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>tkn_Physics.CurrentSpeedKmh</Value>
                </Property>
                <Property Name="AssignmentsNewValue" Units="Kilometers per Hour">Math.If(tkn_Physics.TrueAccelerate_FalseDecelerate,tkn_Physics.CurrentSpeedKmh+1,tkn_Physics.CurrentSpeedKmh-1)</Property>
              </Properties>
              <Properties>
                <Property Name="AssignmentsStateVariableName">
                  <Value>Movement.Rate</Value>
                </Property>
                <Property Name="AssignmentsNewValue" Units="Kilometers per Hour">tkn_Physics.CurrentSpeedKmh</Property>
              </Properties>
            </Rows>
          </Property>
        </Properties>
        <Exit Name="Exit" Type="Primary" NextID="7" />
      </Step>
      <Step Type="Decide" Name="Current&lt;Target" ID="7">
        <Properties>
          <Property Name="DecideType">ConditionBased</Property>
          <Property Name="ConditionOrProbability">Math.If(tkn_Physics.TrueAccelerate_FalseDecelerate,tkn_Physics.CurrentSpeedKmh&lt;tkn_Physics.TargetSpeedKmh,tkn_Physics.CurrentSpeedKmh&gt;tkn_Physics.TargetSpeedKmh)</Property>
        </Properties>
        <Exit Name="True" Type="Primary" NextID="4" />
      </Step>
    </Steps>
  </Process>
</Fragment>
